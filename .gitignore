# Simulation output
*.npz

# Regression fixtures are version controlled.  The 'data/' rule above excludes
# the whole directory, and git will not descend into an excluded directory, so
# the directory itself has to be re-included before the files can be.
!tests/data/
!tests/data/*.npz
